# Required: a New Relic user key. Prefer the mounted-file variant in production.
NEW_RELIC_API_KEY=
# NEW_RELIC_API_KEY_FILE=/run/secrets/new_relic_api_key

# New Relic tenant boundary.
NEW_RELIC_REGION=US
# NEW_RELIC_DEFAULT_ACCOUNT_ID=1234567
# NEW_RELIC_ACCOUNT_ALLOWLIST=1234567,7654321

# Comma-separated toolsets: core,nrql,entities,alerts,dashboards,synthetics,
# workloads,service-levels,logs,metrics,admin (or "all").
NEW_RELIC_TOOLSETS=core,nrql,entities,alerts,dashboards,synthetics,workloads,service-levels,logs,metrics

# Safety gates. All are false unless explicitly enabled.
NEW_RELIC_ENABLE_WRITES=false
NEW_RELIC_ENABLE_DESTRUCTIVE=false
NEW_RELIC_ENABLE_ADMIN=false
NEW_RELIC_ENABLE_PREVIEW_APIS=false
NEW_RELIC_ENABLE_EXPERIMENTAL_AI_ISSUES=false

# Upstream limits. Keep total concurrency below New Relic's per-user limit of 25.
NEW_RELIC_CONCURRENCY=20
NEW_RELIC_NRQL_CONCURRENCY=5
NEW_RELIC_TIMEOUT_MS=30000
NEW_RELIC_NRQL_TIMEOUT_MS=60000
NEW_RELIC_MAX_RESPONSE_BYTES=1048576
NEW_RELIC_CACHE_TTL_MS=0
NEW_RELIC_CACHE_MAX_ENTRIES=500

# HTTP transport. Stdio ignores these settings.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost
MCP_HTTP_ALLOWED_ORIGINS=
MCP_HTTP_MAX_BODY_BYTES=1048576

# Authentication: none (loopback only), bearer, or oidc.
MCP_AUTH_MODE=none
# MCP_BEARER_TOKEN= # 32–8192 bytes; generate with `openssl rand -hex 32`
# MCP_BEARER_TOKEN_FILE=/run/secrets/mcp_bearer_token
# MCP_OIDC_ISSUER=https://identity.example.com/
# MCP_OIDC_AUDIENCE=https://newrelic-mcp.example.com/mcp
# MCP_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# MCP_OIDC_ALGORITHMS=RS256,ES256
# MCP_OIDC_RESOURCE_URL=https://newrelic-mcp.example.com/mcp
# MCP_ALLOW_INSECURE_REMOTE=false

# Runtime observability. Never set LOG_LEVEL=trace with sensitive production data.
LOG_LEVEL=info
MCP_METRICS_ENABLED=false
MCP_TELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=newrelic-mcp
# Standard OTEL_* exporter variables may be used when an SDK is preloaded externally.

# Opt-in live test settings (use a non-production/disposable account only).
# NEW_RELIC_LIVE_TESTS=false
# NEW_RELIC_LIVE_TEST_ACCOUNT_ID=1234567
# NEW_RELIC_LIVE_WRITE_TESTS=false
# NEW_RELIC_LIVE_DISPOSABLE_ACCOUNT_ID=1234567
