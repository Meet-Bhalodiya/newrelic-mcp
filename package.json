{
  "name": "@meet-bhalodiya/newrelic-mcp",
  "version": "1.0.0",
  "description": "Production-grade, self-hostable Model Context Protocol server for New Relic",
  "type": "module",
  "license": "Apache-2.0",
  "mcpName": "io.github.Meet-Bhalodiya/newrelic-mcp",
  "author": "Meet Bhalodiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meet-Bhalodiya/newrelic-mcp.git"
  },
  "homepage": "https://github.com/Meet-Bhalodiya/newrelic-mcp#readme",
  "bugs": {
    "url": "https://github.com/Meet-Bhalodiya/newrelic-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "new-relic",
    "observability",
    "nerdgraph",
    "nrql"
  ],
  "engines": {
    "node": ">=22.7.5"
  },
  "packageManager": "npm@10.8.2",
  "bin": {
    "newrelic-mcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "server.json",
    "mcpb.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist coverage .vitest",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/cli.ts",
    "dev:http": "tsx watch src/cli.ts http --host 127.0.0.1 --port ${CONDUCTOR_PORT:-3000}",
    "start": "node dist/cli.js",
    "start:http": "node dist/cli.js http",
    "doctor": "node dist/cli.js doctor",
    "tools": "node dist/cli.js tools --json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage --exclude 'test/load/**' --testTimeout=60000 --hookTimeout=60000",
    "test:load": "node --expose-gc ./node_modules/vitest/vitest.mjs run test/load --testTimeout=120000",
    "test:live": "vitest run --config vitest.live.config.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "prepack": "npm run clean && npm run build",
    "postinstall": "node -e \"const m=Number(process.versions.node.split('.')[0]);if(m<22)console.warn('newrelic-mcp requires Node 22.7.5 or newer; use Node 24 LTS for production.')\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentelemetry/api": "1.9.1",
    "commander": "15.0.0",
    "express": "5.2.1",
    "graphql": "16.14.2",
    "jose": "6.2.3",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.0.3",
    "prettier": "3.9.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
