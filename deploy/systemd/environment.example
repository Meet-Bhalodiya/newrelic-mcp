NEW_RELIC_API_KEY_FILE=/etc/newrelic-mcp/secrets/new-relic-api-key
NEW_RELIC_REGION=US
NEW_RELIC_DEFAULT_ACCOUNT_ID=1234567
NEW_RELIC_ACCOUNT_ALLOWLIST=1234567
NEW_RELIC_TOOLSETS=core,nrql,entities,alerts,dashboards,synthetics,workloads,service-levels,logs,metrics
NEW_RELIC_CONCURRENCY=20
NEW_RELIC_NRQL_CONCURRENCY=5
NEW_RELIC_MAX_RESPONSE_BYTES=1048576

MCP_AUTH_MODE=bearer
MCP_BEARER_TOKEN_FILE=/etc/newrelic-mcp/secrets/mcp-bearer-token
MCP_HTTP_ALLOWED_HOSTS=newrelic-mcp.example.com,127.0.0.1,localhost
MCP_HTTP_ALLOWED_ORIGINS=
MCP_HTTP_MAX_BODY_BYTES=1048576

LOG_LEVEL=info
MCP_METRICS_ENABLED=false
MCP_TELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=newrelic-mcp
